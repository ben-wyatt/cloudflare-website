---
layout: layout.njk
title: Staff Picks · Record Club
permalink: "/records/match/"
pageStyles: "/styles/records.css?v=clues-under-cover"
pageScript: "/assets/js/match-record.js?v=side-by-side"
bodyClass: "records-page record-game-page record-match-page"
---

<section class="game-shell match-shell" aria-labelledby="match-title">
  <div id="match-loading" class="records-panel game-loading" role="status">
    Sorting the record wall…
  </div>

  <section id="match-gate" class="records-panel game-gate" hidden aria-labelledby="match-gate-title">
    <p class="records-eyebrow">private game</p>
    <h1 id="match-gate-title">This room is locked</h1>
    <p id="match-gate-message">Sign in to play.</p>
    <a class="records-primary game-back-link" href="/records/">Go to Record Club</a>
  </section>

  <div id="match-app" class="game-app" hidden data-fullscreen-target>
    <div class="records-member-bar game-member-bar">
      <p>Playing as <strong id="match-member-name"></strong></p>
      <div class="game-member-actions">
        <button class="game-fullscreen" type="button" data-fullscreen-toggle hidden aria-label="Full screen"></button>
        <a class="game-back-link" href="/records/games/">Back to minigames</a>
      </div>
    </div>

    <header class="game-masthead game-masthead-compact">
      <div class="game-masthead-copy">
        <h1 id="match-title">Staff Picks</h1>
        <p class="game-deck">{{ recordCopy.matchInstructions | safe }}</p>
      </div>
      <div class="game-scoreboard" aria-label="Your Staff Picks statistics">
        <div class="game-score-stat game-score-stat-primary">
          <strong id="match-total-matches">0</strong>
          <span>matches</span>
        </div>
        <div class="game-score-stat">
          <strong id="match-rounds-played">0</strong>
          <span>rounds</span>
        </div>
        <div class="game-score-stat">
          <strong id="match-perfect-rounds">0</strong>
          <span>perfect</span>
        </div>
      </div>
    </header>

    <section id="match-round" class="match-round" hidden aria-labelledby="match-listener-prompt">
      <div class="match-side">
        <div class="match-prompt">
          <p class="records-eyebrow">this listener chose two</p>
          <h2 id="match-listener-prompt"><span id="match-listener-name"></span>'s staff picks</h2>
          <p>{{ recordCopy.matchRoundPrompt | safe }}</p>
        </div>
        <ol id="match-clues" class="match-clues" aria-live="polite" hidden></ol>
        <div class="match-round-end">
          <p id="match-status" class="game-status match-status" role="status" aria-live="polite"></p>
          <button id="match-next" class="records-text-button game-next" type="button" hidden>Next listener <kbd aria-hidden="true">↵</kbd></button>
        </div>
      </div>

      <div id="match-choices" class="match-choices" role="group" aria-label="Eight album choices"></div>

      <dialog id="match-details" class="match-details" aria-labelledby="match-details-title">
        <div class="match-details-heading">
          <div>
            <p class="records-eyebrow">record details</p>
            <h2 id="match-details-title"></h2>
            <p id="match-details-artist" class="match-details-artist"></p>
          </div>
          <button id="match-details-close" class="records-text-button" type="button" aria-label="Close record details">Close ×</button>
        </div>
        <p id="match-details-note" class="match-details-note" hidden></p>
        <p><a id="match-details-spotify" href="#" target="_blank" rel="noopener noreferrer">Open album on Spotify ↗</a></p>
        <h3>Track list</h3>
        <div id="match-details-tracks" role="status" aria-live="polite"></div>
      </dialog>

    </section>

  </div>
</section>
<script src="/assets/js/game-fullscreen.js?v=fullscreen" defer></script>
