---
layout: layout.njk
title: Crates · Record Club
permalink: "/records/crates/"
pageStyles: "/styles/records-lab.css?v=lab-3"
pageScript: "/assets/js/record-crates.js?v=lab-3"
bodyClass: "records-page record-game-page lab-page lab-crates-page"
eleventyExcludeFromCollections: true
---

<section class="game-shell lab-shell crates-shell" aria-labelledby="crates-title">
  <div id="crates-loading" class="records-panel game-loading" role="status">Filling the crates…</div>

  <section id="crates-gate" class="records-panel game-gate" hidden aria-labelledby="crates-gate-title">
    <p class="records-eyebrow">private game</p>
    <h1 id="crates-gate-title">No crates yet</h1>
    <p id="crates-gate-message"></p>
    <a class="records-primary game-back-link" href="/records/games/">Back to minigames</a>
  </section>

  <div id="crates-app" class="game-app" hidden data-fullscreen-target>
    <div class="records-member-bar game-member-bar">
      <p>Playing as <strong id="crates-member-name"></strong></p>
      <div class="game-member-actions">
        <button class="game-fullscreen" type="button" data-fullscreen-toggle hidden aria-label="Full screen"></button>
        <a class="game-back-link" href="/records/games/">Back to minigames</a>
      </div>
    </div>

    <header class="game-masthead game-masthead-compact">
      <div class="game-masthead-copy">
        <h1 id="crates-title">Crates</h1>
        <p class="game-deck">{{ recordCopy.cratesInstructions | safe }}</p>
        <p class="game-scoring-rule lab-modes">
          <button id="crates-previous" class="records-text-button" type="button">← Previous</button>
          <span aria-hidden="true">·</span>
          <span id="crates-number"></span>
          <span aria-hidden="true">·</span>
          <button id="crates-next-puzzle" class="records-text-button" type="button">Next →</button>
        </p>
        <p id="crates-review" class="game-scoring-rule lab-modes crates-review" hidden>
          <span id="crates-status-label"></span>
          <span aria-hidden="true">·</span>
          <button class="records-text-button" type="button" data-review="approved">Approve</button>
          <span aria-hidden="true">·</span>
          <button class="records-text-button" type="button" data-review="rejected">Reject</button>
          <span aria-hidden="true">·</span>
          <button class="records-text-button" type="button" data-review="draft">Back to draft</button>
        </p>
      </div>
      <div class="game-scoreboard" aria-label="This puzzle">
        <div class="game-score-stat game-score-stat-primary">
          <strong id="crates-found">0</strong>
          <span>of 4 found</span>
        </div>
        <div class="game-score-stat">
          <strong id="crates-mistakes">0</strong>
          <span>mistakes</span>
        </div>
        <div class="game-score-stat">
          <strong id="crates-left">16</strong>
          <span>records left</span>
        </div>
      </div>
    </header>

    <section class="crates-round" aria-label="The puzzle">
      <ol id="crates-solved" class="crates-solved" aria-label="Groups found"></ol>
      <ul id="crates-grid" class="crates-grid" aria-label="Records"></ul>

      <div class="crates-end">
        <p id="crates-status" class="game-status" role="status" aria-live="polite"></p>
        <p class="crates-actions">
          <button id="crates-shuffle" class="records-text-button" type="button">Shuffle</button>
          <span aria-hidden="true">·</span>
          <button id="crates-clear" class="records-text-button" type="button">Deselect</button>
          <span aria-hidden="true">·</span>
          <button id="crates-give-up" class="records-text-button" type="button">Show the groups</button>
          <button id="crates-check" class="records-text-button game-next" type="button" disabled>Check <kbd aria-hidden="true">↵</kbd></button>
          <button id="crates-next" class="records-text-button game-next" type="button" hidden>Next puzzle <kbd aria-hidden="true">↵</kbd></button>
        </p>
      </div>

      <section id="crates-notes" class="crates-notes" hidden aria-labelledby="crates-notes-title">
        <h2 id="crates-notes-title" class="records-eyebrow">review notes · owners only</h2>
        <div id="crates-notes-body"></div>
      </section>
    </section>
  </div>
</section>
<script src="/assets/js/game-fullscreen.js?v=fullscreen" defer></script>
