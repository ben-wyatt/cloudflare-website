title: The whole room · Record Club
permalink: "/records/lists/"
pageStyles: "/styles/records-wrapped.css?v=lists-v2"
pageScript: "/assets/js/record-lists.js?v=lists-v2"
bodyClass: "records-wrapped-page"
---

<section class="wrapped-shell">
  <div id="lists-loading" class="wrapped-loading" role="status">Opening the shelves…</div>

  <section id="lists-gate" class="wrapped-gate" hidden aria-labelledby="lists-gate-title">
    <h1 id="lists-gate-title">The lists are inside.</h1>
    <p id="lists-gate-message">Sign in through Record Club to read your group’s lists.</p>
    <p><a href="/records/">Go to Record Club →</a></p>
  </section>

  <div id="lists-app" hidden>
    <nav class="wrapped-member-bar" aria-label="Record Club">
      <p>Reading as <strong id="lists-member-name"></strong></p>
      <p><span id="lists-all-link" hidden><a href="/records/lists/" data-member-link>All lists</a> <span aria-hidden="true">·</span></span> <a href="/records/wrapped/">Liner Notes</a> <span aria-hidden="true">·</span> <a href="/records/">Ballot</a></p>
    </nav>

    <div id="lists-room">
      <header class="wrapped-masthead">
        <p class="wrapped-kicker">record club · <span data-lists-season>2026</span></p>
        <h1 id="lists-title" tabindex="-1">The whole room</h1>
        <p class="wrapped-intro">{{ recordCopy.listsIntroduction | safe }}</p>
      </header>

      <form id="lists-search-form" class="wrapped-list-search" role="search">
        <label for="lists-search">Find a record, artist, or word from a note</label>
        <input id="lists-search" type="search" autocomplete="off" placeholder="search the room">
      </form>
      <p id="lists-count" class="wrapped-edition-status" role="status"></p>
      <ul id="lists-shelves" class="wrapped-shelves" aria-label="Each listener’s list"></ul>
      <p id="lists-waiting" class="wrapped-list-meta" hidden></p>
      <div id="lists-results" hidden></div>
    </div>

    <article id="lists-person" hidden aria-labelledby="lists-person-name">
      <header class="wrapped-masthead">
        <p class="wrapped-kicker">record club · <span data-lists-season>2026</span><span id="lists-person-position"></span></p>
        <h1 id="lists-person-name" tabindex="-1"></h1>
        <p id="lists-person-summary" class="wrapped-intro"></p>
      </header>
      <div id="lists-person-body"></div>
      <nav id="lists-pager" class="wrapped-list-pager" aria-label="Other lists"></nav>
    </article>

    <footer class="wrapped-colophon"><p><a href="/records/wrapped/">Back to Wrapped ←</a></p></footer>
  </div>
</section>
