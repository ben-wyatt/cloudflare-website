---
layout: layout.njk
title: Flip Side · Record Club
permalink: "/records/guess/"
pageStyles: "/styles/records-lab.css?v=lab-4"
pageScript: "/assets/js/record-guess.js?v=lab-4"
bodyClass: "records-page record-game-page lab-page lab-ask-page"
eleventyExcludeFromCollections: true
---

<section class="game-shell lab-shell" aria-labelledby="ask-title">
  <div id="ask-loading" class="records-panel game-loading" role="status">Dealing the board…</div>

  <section id="ask-gate" class="records-panel game-gate" hidden aria-labelledby="ask-gate-title">
    <p class="records-eyebrow">private game</p>
    <h1 id="ask-gate-title">This round could not start</h1>
    <p id="ask-gate-message"></p>
    <a class="records-primary game-back-link" href="/records/games/">Back to minigames</a>
  </section>

  <div id="ask-app" class="game-app" hidden data-fullscreen-target>
    <div class="records-member-bar game-member-bar">
      <p>Playing as <strong id="ask-member-name"></strong></p>
      <div class="game-member-actions">
        <button class="game-fullscreen" type="button" data-fullscreen-toggle hidden aria-label="Full screen"></button>
        <a class="game-back-link" href="/records/games/">Back to minigames</a>
      </div>
    </div>

    <header class="game-masthead game-masthead-compact">
      <div class="game-masthead-copy">
        <h1 id="ask-title">Flip Side</h1>
        <p id="ask-deck" class="game-deck">{{ recordCopy.flipSideInstructions | safe }}</p>
      </div>
      <div class="game-scoreboard" aria-label="This round">
        <div class="game-score-stat game-score-stat-primary">
          <strong id="ask-stat-0">0</strong>
          <span id="ask-stat-0-label"></span>
        </div>
        <div class="game-score-stat">
          <strong id="ask-stat-1">0</strong>
          <span id="ask-stat-1-label"></span>
        </div>
        <div class="game-score-stat">
          <strong id="ask-stat-2">0</strong>
          <span id="ask-stat-2-label"></span>
        </div>
      </div>
    </header>

    <section class="lab-round" aria-label="The round">
      <div class="lab-side">
        <form id="ask-form" class="lab-ask-form" autocomplete="off">
          <label id="ask-label" class="records-eyebrow" for="ask-input"></label>
          <div class="lab-ask-row">
            <input id="ask-input" name="question" type="text" maxlength="200" enterkeyhint="send" required>
            <button id="ask-submit" class="records-text-button game-next" type="submit"><span id="ask-submit-word">Ask</span> <kbd aria-hidden="true">↵</kbd></button>
          </div>
        </form>

        <div id="ask-answer" class="lab-answer" aria-live="polite" hidden>
          <p id="ask-answer-question" class="lab-answer-question"></p>
          <p id="ask-answer-line" class="game-status"></p>
        </div>

        <p id="ask-guess-line" class="lab-guess-line" hidden>
          Guess <strong id="ask-guess-label"></strong>?
          <button id="ask-guess" class="records-text-button" type="button">Guess</button>
          <span aria-hidden="true">·</span>
          <button id="ask-guess-cancel" class="records-text-button" type="button">Cancel</button>
        </p>

        <section id="ask-reveal" class="lab-reveal" hidden aria-live="polite"></section>

        <p class="lab-round-actions">
          <button id="ask-give-up" class="records-text-button" type="button">Show me</button>
          <span aria-hidden="true">·</span>
          <button id="ask-new" class="records-text-button" type="button">New board</button>
        </p>

        <section class="lab-history-wrap" aria-labelledby="ask-history-title">
          <h2 id="ask-history-title" class="records-eyebrow">asked so far</h2>
          <ol id="ask-history" class="lab-history"></ol>
        </section>
      </div>

      <ul id="ask-board" class="lab-board" aria-label="The board"></ul>
    </section>

    <div class="game-footer game-developer-tools">
      <span class="records-eyebrow" aria-hidden="true">under the hood</span>
      <label class="lab-numbers"><input id="ask-numbers" type="checkbox"> show Jev's numbers on the cards</label>
    </div>
  </div>
</section>
<script src="/assets/js/game-fullscreen.js?v=fullscreen" defer></script>
