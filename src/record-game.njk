---
layout: layout.njk
title: Who Picked It? · Record Club
permalink: "/records/game/"
pageStyles: "/styles/records.css?v=one-screen"
pageScript: "/assets/js/record-game.js?v=one-screen"
bodyClass: "records-page record-game-page"
---

<section class="game-shell" aria-labelledby="game-title">
  <div id="game-loading" class="records-panel game-loading" role="status">
    Shuffling the record bin…
  </div>

  <section id="game-gate" class="records-panel game-gate" hidden aria-labelledby="game-gate-title">
    <p class="records-eyebrow">private game</p>
    <h1 id="game-gate-title">This room is locked</h1>
    <p id="game-gate-message">Sign in to play.</p>
    <a class="records-primary game-back-link" href="/records/">Go to Record Club</a>
  </section>

  <div id="game-app" class="game-app" hidden data-fullscreen-target>
    <div class="records-member-bar game-member-bar">
      <p>Playing as <strong id="game-member-name"></strong></p>
      <div class="game-member-actions">
        <button class="game-fullscreen" type="button" data-fullscreen-toggle hidden aria-label="Full screen"></button>
        <a class="game-back-link" href="/records/games/">Back to games</a>
      </div>
    </div>

    <header class="game-masthead game-masthead-compact">
      <div class="game-masthead-copy">
        <h1 id="game-title">Who Picked It?</h1>
        <p class="game-deck">{{ recordCopy.whoPickedInstructions | safe }}</p>
        <p class="game-scoring-rule">{{ recordCopy.whoPickedScoring | safe }}</p>
      </div>
      <div class="game-scoreboard" aria-label="Your game statistics">
        <div class="game-score-stat game-score-stat-primary">
          <strong id="game-total-points">0</strong>
          <span>points</span>
        </div>
        <div class="game-score-stat">
          <strong id="game-rounds-solved">0</strong>
          <span>solved</span>
        </div>
        <div class="game-score-stat">
          <strong id="game-perfect-rounds">0</strong>
          <span>perfect</span>
        </div>
      </div>
    </header>

    <section id="game-round" class="game-round" hidden aria-label="Current mystery record">
      <div class="game-round-cover">
        <figure class="game-cover-frame">
          <div class="game-cover-wrap">
            <img id="game-cover" class="game-cover" src="" alt="Mystery album cover">
            <span id="game-points-burst" class="game-points-burst" hidden aria-hidden="true"></span>
          </div>
          <figcaption class="sr-only">A randomly selected cover from the group’s album picks.</figcaption>
        </figure>
        <div class="game-cover-meta">
          <div id="game-progress" class="game-progress" aria-label="Clues revealed">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </div>
          <p id="game-selector-count" class="game-selector-count" hidden></p>
        </div>
      </div>

      <div class="game-round-play">
        <div id="game-clue-list" class="game-clue-list" aria-label="Unlocked clues"></div>

        <div class="game-round-guess">
          <h2 class="game-choices-title">Choose a listener</h2>
          <div id="game-choices" class="game-choices" role="group" aria-label="Record Club members"></div>
          <div class="game-round-end">
            <p id="game-status" class="game-status" role="status" aria-live="polite"></p>
            <button id="game-next" class="records-text-button game-next" type="button" hidden>Next album <kbd>↵</kbd></button>
          </div>
        </div>
      </div>
    </section>

    <div id="game-developer-tools" class="game-footer game-developer-tools" hidden>
      <span class="records-eyebrow" aria-hidden="true">developer draw</span>
      <label for="game-developer-source">Next album from</label>
      <select id="game-developer-source" name="game-developer-source">
        <option value="">Anyone (random)</option>
      </select>
    </div>
  </div>
</section>
<script src="/assets/js/game-fullscreen.js?v=fullscreen" defer></script>
